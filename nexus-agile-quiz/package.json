{
  "name": "nexus-agile-quiz",
  "version": "1.0.0",
  "description": "Nexus Agile Quiz (敏捷开发问答) example app",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "web/main"
  ],
  "scripts": {
    "build-web": "npm run build -w nexus-agile-quiz-web-main",
    "start-web": "npm run start -w nexus-agile-quiz-web-main",
    "build": "tsc && npm run build-web",
    "serve": "nexus serve --environment development",
    "start": "concurrently \"npm run start-web\" \"npm run serve\"",
    "deploy-only": "nexus deploy",
    "nexus-build": "nexus build only --verbose",
    "deploy": "npm run build-web && nexus deploy"
  },
  "devDependencies": {
    "@pc-nexus/cli": "0.8.0",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@pc-nexus/core": "^0.8.0",
    "@pc-nexus/manifest": "^0.8.0"
  }
}
